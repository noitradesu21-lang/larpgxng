ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = pg

-- Main window
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 420, 0, 280)
Main.Position = UDim2.new(0.5, -200, 0.5, -160)
Main.BackgroundColor3 = Theme.Bg
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

local MainStroke = Instance.new("UIStroke", Main)
MainStroke.Thickness = 1
MainStroke.Color = Theme.Acc
MainStroke.Transparency = 0.4

-- Animated gradient border
local Grad = Instance.new("UIGradient", MainStroke)
Grad.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Theme.Acc),
    ColorSequenceKeypoint.new(0.5, Theme.Acc2),
    ColorSequenceKeypoint.new(1, Theme.Acc),
})
task.spawn(function()
    while ScreenGui.Parent do
        Grad.Rotation = (Grad.Rotation + 1) % 360
        RunService.RenderStepped:Wait()
    end
end)

