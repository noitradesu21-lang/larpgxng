-- Executor-style UI | Toggle with P or the X button
-- Fixed build:
--   * Preset list scrolls properly (AutomaticCanvasSize)
--   * Leg snapshots reset on respawn (no stale mesh IDs on a new body)
--   * Asset ID input is sanitized (full URLs accepted)
--   * Presets render in stable alphabetical order
--   * Toggle tween is guarded against rapid P / X spam
--   * No deprecated two-arg Instance.new calls
--   * Hide animation is slide-only (children no longer float opaque)
--   * Black & white glass theme (translucent panels, monochrome accents)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local CONFIG_FILE = "larp_configs.json"
local TOGGLE_KEY = Enum.KeyCode.P

-- Tracked state (declared early so the respawn handler can reset it)
local equippedSession = {}
local originalLegProps = {}    -- [partName] = {MeshId, TextureID, Transparency}
local equippedAccessories = {} -- accessory instances added by this script
local legModified = false

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
LocalPlayer.CharacterAdded:Connect(function(c)
    Character = c
    -- New body: any old leg snapshot is stale, so start fresh
    originalLegProps = {}
    legModified = false
end)

-- Theme (black & white glass)
local Theme = {
    Bg      = Color3.fromRGB(10, 10, 12),
    Side    = Color3.fromRGB(16, 16, 18),
    Sec     = Color3.fromRGB(26, 26, 28),
    Btn     = Color3.fromRGB(34, 34, 36),
    Acc     = Color3.fromRGB(245, 245, 245),
    Acc2    = Color3.fromRGB(150, 150, 155),
    Txt     = Color3.fromRGB(255, 255, 255),
    TxtD    = Color3.fromRGB(155, 155, 160),
    Suc     = Color3.fromRGB(235, 235, 235),
    Err     = Color3.fromRGB(215, 215, 215),
    -- Per-element transparency for the glassy look
    TMain   = 0.25,
    TBar    = 0.15,
    TField  = 0.25,
    TBtn    = 0.15,
    TRow    = 0.30,
}

local function Tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

