-- Tab buttons (top row, executor style)
local TabHolder = Instance.new("Frame")
TabHolder.Size = UDim2.new(1, -20, 0, 30)
TabHolder.Position = UDim2.new(0, 10, 0, 42)
TabHolder.BackgroundTransparency = 1
TabHolder.Parent = Main

local tabs = {}
local function MakeTab(name, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1/3, -4, 1, 0)
    b.Position = UDim2.new((order - 1) / 3, 0, 0, 0)
    b.BackgroundColor3 = Theme.Btn
    b.Text = name
    b.TextColor3 = Theme.TxtD
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Parent = TabHolder
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local st = Instance.new("UIStroke", b)
    st.Thickness = 1
    st.Color = Theme.Sec
    b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = Theme.Acc2}, 0.15) end)
    b.MouseLeave:Connect(function()
        if not tabs[name].selected then Tween(b, {BackgroundColor3 = Theme.Btn}, 0.15) end
    end)
    tabs[name] = {button = b, stroke = st}
    return b
end

local TabEquipBtn = MakeTab("EQUIP", 1)
local TabPresetsBtn = MakeTab("PRESETS", 2)
local TabExtrasBtn = MakeTab("EXTRAS", 3)

-- Pages
local function MakePage()
    local p = Instance.new("Frame")
    p.Size = UDim2.new(1, -20, 1, -128)
    p.Position = UDim2.new(0, 10, 0, 78)
    p.BackgroundTransparency = 1
    p.Visible = false
    p.Parent = Main
    return p
end
local PageEquip = MakePage()
local PagePresets = MakePage()
local PageExtras = MakePage()

-- Status bar (bottom)
local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 22)
Status.Position = UDim2.new(0, 10, 1, -30)
Status.BackgroundTransparency = 1
Status.Text = "Ready."
Status.TextColor3 = Theme.TxtD
Status.TextSize = 12
Status.Font = Enum.Font.GothamMedium
Status.TextXAlignment = Enum.TextXAlignment.Left
Status.Parent = Main

-- Button hover/press effect
local function StyleButton(btn)
    btn.MouseEnter:Connect(function()
        Tween(btn, {Size = btn.Size + UDim2.new(0, 4, 0, 4), Position = btn.Position - UDim2.new(0, 2, 0, 2)}, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, {Size = btn.Size - UDim2.new(0, 4, 0, 4), Position = btn.Position + UDim2.new(0, 2, 0, 2)}, 0.1)
    end)
end

local function NewButton(text, parent, size, pos, color)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = color or Theme.Acc
    b.Text = text
    b.TextColor3 = Theme.Txt
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    StyleButton(b)
    return b
end

