-- Executor-style UI | Toggle with P or the X button

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
LocalPlayer.CharacterAdded:Connect(function(c) Character = c end)

local CONFIG_FILE = "larp_configs.json"
local TOGGLE_KEY = Enum.KeyCode.P

-- Theme (executor dark style)
local Theme = {
    Bg      = Color3.fromRGB(22, 22, 30),
    Side    = Color3.fromRGB(30, 30, 40),
    Sec     = Color3.fromRGB(40, 40, 54),
    Btn     = Color3.fromRGB(50, 50, 68),
    Acc     = Color3.fromRGB(140, 85, 255),
    Acc2    = Color3.fromRGB(90, 60, 220),
    Txt     = Color3.fromRGB(240, 240, 255),
    TxtD    = Color3.fromRGB(150, 150, 170),
    Suc     = Color3.fromRGB(60, 200, 120),
    Err     = Color3.fromRGB(235, 80, 90),
}

local function Tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- Destroy old instances
local pg = LocalPlayer:WaitForChild("PlayerGui")
if pg:FindFirstChild("GivedebtsV13") then pg.GivedebtsV13:Destroy() end
if pg:FindFirstChild("GivedebtsLarpTool") then pg.GivedebtsLarpTool:Destroy() end

