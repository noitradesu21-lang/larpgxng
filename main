-- Helper UI Functions
-- (Hover grow animation removed so buttons stay put while clicking)
local function NewButton(text, parent, size, pos, color)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    local bg = color or Theme.Acc
    b.BackgroundColor3 = bg
    b.BackgroundTransparency = Theme.TBtn
    b.Text = text
    -- Dark text on light (white) buttons, white text on dark ones
    b.TextColor3 = (bg.R + bg.G + bg.B) > 1.5 and Color3.fromRGB(15, 15, 18) or Theme.Txt
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = b

    return b
end

