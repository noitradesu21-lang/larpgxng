-- ===== CORE LOGIC & FUNCTIONS =====
local LEG_PARTS = {
    "LeftFoot", "LeftLowerLeg", "LeftUpperLeg",
    "RightFoot", "RightLowerLeg", "RightUpperLeg",
}

local function SnapshotLegs()
    if legModified then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, partName in ipairs(LEG_PARTS) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            originalLegProps[partName] = {
                MeshId = part.MeshId,
                TextureID = part.TextureID,
                Transparency = part.Transparency,
            }
        end
    end
end

local function ResetLegs()
    local char = LocalPlayer.Character
    if not char then
        Status.Text = "No character to reset."
        Status.TextColor3 = Theme.Err
        return
    end
    if not legModified then
        Status.Text = "Legs are already normal."
        Status.TextColor3 = Theme.TxtD
        return
    end
    local ok = pcall(function()
        for partName, props in pairs(originalLegProps) do
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                part.MeshId = props.MeshId
                part.TextureID = props.TextureID
                part.Transparency = props.Transparency
            end
        end
    end)
    originalLegProps = {}
    legModified = false
    if ok then
        Status.Text = "Legs reverted to normal."
        Status.TextColor3 = Theme.Suc
    else
        Status.Text = "Failed to reset legs."
        Status.TextColor3 = Theme.Err
    end
end

local function ResetEverything()
    -- Remove accessories/shirts/pants equipped by this script.
    -- Leg mods are intentionally left alone (use RESET LEGS on the KORBLOX tab).
    local removed = 0
    for _, inst in ipairs(equippedAccessories) do
        if inst and inst.Parent then
            inst:Destroy()
            removed = removed + 1
        end
    end
    equippedAccessories = {}
    equippedSession = {}
    Status.Text = "Everything reset. (" .. removed .. " items removed)"
    Status.TextColor3 = Theme.Suc
end

local function LoadConfig()
    local has = isfile or function() return false end
    if has(CONFIG_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and data then return data end
    end
    return {}
end

local function equip(assetId, silent)
    Status.Text = "Loading asset..."
    Status.TextColor3 = Theme.Acc
    local ok, objects = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
    if not (ok and objects and #objects > 0) then
        Status.Text = "Asset failed to load."
        Status.TextColor3 = Theme.Err
        return
    end

    local found
    local function findWearable(m)
        for _, ch in ipairs(m:GetChildren()) do
            if ch:IsA("Accessory") or ch:IsA("Tool") or ch:IsA("Shirt") or ch:IsA("Pants") then
                found = ch
                return
            end
            findWearable(ch)
        end
    end

    for _, o in ipairs(objects) do
        if o:IsA("Accessory") or o:IsA("Tool") or o:IsA("Shirt") or o:IsA("Pants") then
            found = o
            break
        end
        findWearable(o)
        if found then break end
    end

    if not found then
        Status.Text = "Not a wearable object."
        Status.TextColor3 = Theme.Err
        return
    end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if found:IsA("Accessory") and humanoid then
        local handle = found:FindFirstChild("Handle")
        if handle then
            handle.Transparency = 0
            handle.CanCollide = false
            handle.Anchored = false
        end
        humanoid:AddAccessory(found)

        task.delay(0.1, function()
            if handle and handle.Parent == found then
                local att = handle:FindFirstChildOfClass("Attachment")
                local targetPart = Character:FindFirstChild("Head")

                if att then
                    for _, part in ipairs(Character:GetChildren()) do
                        if part:IsA("BasePart") and part:FindFirstChild(att.Name) then
                            targetPart = part
                            break
                        end
                    end
                end

                if targetPart then
                    local weld = handle:FindFirstChild("AccessoryWeld")
                    if not weld then
                        weld = Instance.new("Weld")
                        weld.Name = "AccessoryWeld"
                        weld.Parent = handle
                    end
                    weld.Part0 = handle
                    weld.Part1 = targetPart
                    local targetAtt = att and targetPart:FindFirstChild(att.Name)
                    if att and targetAtt then
                        weld.C0 = att.CFrame
                        weld.C1 = targetAtt.CFrame
                    end
                end
            end
        end)
    elseif found:IsA("Tool") then
        found.Parent = LocalPlayer.Backpack
    elseif found:IsA("Shirt") or found:IsA("Pants") then
        local old = Character:FindFirstChildOfClass(found.ClassName)
        if old then old:Destroy() end
        found.Parent = Character
    end

    -- Track what we added so RESET can remove it
    if found:IsA("Accessory") or found:IsA("Shirt") or found:IsA("Pants") then
        table.insert(equippedAccessories, found)
    end

    if not silent then table.insert(equippedSession, assetId) end
    Status.Text = "Equipped successfully"
    Status.TextColor3 = Theme.Suc
end

local function RefreshPresets()
    for _, c in ipairs(PresetList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local cfg = LoadConfig()

    -- Collect and sort names so the list order is stable
    local names = {}
    for name, ids in pairs(cfg) do
        if name ~= "ToggleKey" and typeof(ids) == "table" then
            table.insert(names, name)
        end
    end
    table.sort(names)

    for _, presetName in ipairs(names) do
        local ids = cfg[presetName]

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 34)
        row.BackgroundColor3 = Theme.Btn
        row.BackgroundTransparency = Theme.TRow
        row.BorderSizePixel = 0
        row.Parent = PresetList

        local rowCorner = Instance.new("UICorner")
        rowCorner.CornerRadius = UDim.new(0, 8)
        rowCorner.Parent = row

        local rl = Instance.new("TextLabel")
        rl.Size = UDim2.new(0.65, 0, 1, 0)
        rl.Position = UDim2.new(0, 12, 0, 0)
        rl.BackgroundTransparency = 1
        rl.Text = presetName
        rl.TextColor3 = Theme.Txt
        rl.Font = Enum.Font.GothamMedium
        rl.TextSize = 13
        rl.TextXAlignment = Enum.TextXAlignment.Left
        rl.Parent = row

        local lb = NewButton("LOAD", row, UDim2.new(0.28, 0, 0.7, 0), UDim2.new(0.68, 0, 0.15, 0))
        lb.MouseButton1Click:Connect(function()
            for _, id in ipairs(ids) do equip(id, true) end
            Status.Text = "Loaded: " .. presetName
            Status.TextColor3 = Theme.Suc
        end)
    end
end

-- Individual Leg Functions
local function ApplyLeftLeg()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    SnapshotLegs()
    local ok, err = pcall(function()
        if char:FindFirstChild("LeftFoot") then
            char.LeftFoot.MeshId = "http://www.roblox.com/asset/?id=902942077"
            char.LeftFoot.Transparency = 1
        end
        if char:FindFirstChild("LeftLowerLeg") then
            char.LeftLowerLeg.MeshId = "http://www.roblox.com/asset/?id=902942101"
            char.LeftLowerLeg.TextureID = "http://roblox.com/asset/?id=902842271"
        end
        if char:FindFirstChild("LeftUpperLeg") then
            char.LeftUpperLeg.MeshId = "http://www.roblox.com/asset/?id=902942082"
            char.LeftUpperLeg.TextureID = "http://roblox.com/asset/?id=902842271"
        end
    end)

    if ok then
        legModified = true
        Status.Text = "Left leg mods applied!"
        Status.TextColor3 = Theme.Suc
    else
        Status.Text = "Failed to apply left leg mods."
        Status.TextColor3 = Theme.Err
    end
end

local function ApplyRightLeg()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    SnapshotLegs()
    local ok, err = pcall(function()
        if char:FindFirstChild("RightFoot") then
            char.RightFoot.MeshId = "http://www.roblox.com/asset/?id=902942089"
            char.RightFoot.Transparency = 1
        end
        if char:FindFirstChild("RightLowerLeg") then
            char.RightLowerLeg.MeshId = "http://www.roblox.com/asset/?id=902942093"
            char.RightLowerLeg.Transparency = 1
        end
        if char:FindFirstChild("RightUpperLeg") then
            char.RightUpperLeg.MeshId = "http://www.roblox.com/asset/?id=902942096"
            char.RightUpperLeg.TextureID = "http://roblox.com/asset/?id=902843398"
        end
    end)

    if ok then
        legModified = true
        Status.Text = "Right leg mods applied!"
        Status.TextColor3 = Theme.Suc
    else
        Status.Text = "Failed to apply right leg mods."
        Status.TextColor3 = Theme.Err
    end
end

-- ===== Wiring Events =====
EquipBtn.MouseButton1Click:Connect(function()
    -- Accept bare IDs or full catalog URLs; pull out the digits
    local id = AssetBox.Text:match("%d+")
    if id then
        equip(id)
    else
        Status.Text = "Enter a valid Asset ID."
        Status.TextColor3 = Theme.Err
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    if NameBox.Text ~= "" and #equippedSession > 0 then
        local presetName = NameBox.Text
        local cfg = LoadConfig()
        cfg[presetName] = equippedSession
        if writefile then writefile(CONFIG_FILE, HttpService:JSONEncode(cfg)) end
        NameBox.Text = ""
        Status.Text = "Saved: " .. presetName
        Status.TextColor3 = Theme.Suc
        RefreshPresets()
    else
        Status.Text = "No items to save!"
        Status.TextColor3 = Theme.Err
    end
end)

LeftLegBtn.MouseButton1Click:Connect(ApplyLeftLeg)
RightLegBtn.MouseButton1Click:Connect(ApplyRightLeg)
FullResetBtn.MouseButton1Click:Connect(ResetEverything)
LegResetBtn.MouseButton1Click:Connect(ResetLegs)

-- ===== Tab Switching =====
local function SelectTab(idx)
    PageEquip.Visible = idx == 1
    PagePresets.Visible = idx == 2
    PageLegs.Visible = idx == 3
    local order = {TabEquipBtn, TabPresetsBtn, TabLegsBtn}
    for i, b in ipairs(order) do
        local t = tabs[b.Text]
        t.selected = i == idx
        b.TextColor3 = (i == idx) and Theme.Txt or Theme.TxtD
        b.BackgroundColor3 = (i == idx) and Theme.Acc2 or Theme.Btn
    end
    if idx == 2 then RefreshPresets() end
end

TabEquipBtn.MouseButton1Click:Connect(function() SelectTab(1) end)
TabPresetsBtn.MouseButton1Click:Connect(function() SelectTab(2) end)
TabLegsBtn.MouseButton1Click:Connect(function() SelectTab(3) end)

-- ===== Toggle (P Key / Close Button) =====
local visible = true
local activeTween = nil
local function Toggle()
    -- Kill any in-flight tween so rapid toggling can't desync state
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
    visible = not visible
    if visible then
        Main.Visible = true
        activeTween = Tween(Main, {Position = UDim2.new(0.5, -200, 0.5, -160)}, 0.35, Enum.EasingStyle.Elastic)
    else
        -- Slide-only hide: children stay attached to the frame instead of floating opaque
        activeTween = Tween(Main, {Position = UDim2.new(0.5, -200, 0.5, 200)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        activeTween.Completed:Connect(function()
            if not visible then Main.Visible = false end
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == TOGGLE_KEY then Toggle() end
end)
CloseBtn.MouseButton1Click:Connect(Toggle)

-- Initialize UI State
SelectTab(1)
RefreshPresets()
print("larpgxng Loaded (clean, fixed).")
