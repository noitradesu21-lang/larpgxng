-- ===== CLONE FEATURE (NEW) =====
local function ClearLocalOutfit()
    -- Strip the current look so the clone lands on a clean body.
    -- Note: this removes ALL accessories currently on you (including avatar ones);
    -- rejoining or respawning brings your real outfit back, since this is client-side only.
    local humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        for _, acc in ipairs(humanoid:GetAccessories()) do
            acc:Destroy()
        end
    end
    if Character then
        for _, className in ipairs({"Shirt", "Pants"}) do
            local item = Character:FindFirstChildOfClass(className)
            if item then item:Destroy() end
        end
    end
    equippedAccessories = {}
    equippedSession = {}
end

local function CloneOutfit(targetPlayer)
    local targetChar = targetPlayer.Character
    if not (targetChar and Character) then
        Status.Text = "Target has no character."
        Status.TextColor3 = Theme.Err
        return
    end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        Status.Text = "You have no Humanoid."
        Status.TextColor3 = Theme.Err
        return
    end

    ClearLocalOutfit()

    local copied = 0
    for _, item in ipairs(targetChar:GetChildren()) do
        if item:IsA("Accessory") then
            -- Respect REMOVE HAIR: don't clone the target's hair while yours is hidden
            if not (hairRemoved and isHairAccessory(item)) then
                local copy = item:Clone()
                local handle = copy:FindFirstChild("Handle")
                if handle then
                    handle.CanCollide = false
                    handle.Anchored = false
                    handle.Massless = true
                end
                humanoid:AddAccessory(copy)
                table.insert(equippedAccessories, copy)
                copied = copied + 1
            end
        elseif item:IsA("Shirt") or item:IsA("Pants") then
            local copy = item:Clone()
            copy.Parent = Character
            table.insert(equippedAccessories, copy)
            copied = copied + 1
        end
    end

    if copied == 0 then
        Status.Text = targetPlayer.Name .. " has nothing to copy."
        Status.TextColor3 = Theme.TxtD
    else
        Status.Text = "Cloned " .. copied .. " items from " .. targetPlayer.DisplayName
        Status.TextColor3 = Theme.Suc
    end
end

