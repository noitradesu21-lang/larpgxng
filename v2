-- ===== REMOVE HAIR FEATURE (NEW) =====
local function isHairAccessory(acc)
    local handle = acc:FindFirstChild("Handle")
    -- Standard accessory hairs carry a HairAttachment on the handle;
    -- fall back to the name for anything unusual
    if handle and handle:FindFirstChild("HairAttachment") then return true end
    return acc.Name:lower():find("hair") ~= nil
end

local function removeHairNow()
    local char = Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return 0 end

    local removed = 0
    for _, acc in ipairs(humanoid:GetAccessories()) do
        if isHairAccessory(acc) then
            local handle = acc:FindFirstChild("Handle")
            local weld = handle and handle:FindFirstChild("AccessoryWeld")
            if weld then weld:Destroy() end
            acc.Parent = nil -- detach; kept in memory so restore can re-weld it
            table.insert(savedHair, acc)
            removed = removed + 1
        end
    end
    return removed
end

local function restoreHair()
    local char = Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    for _, acc in ipairs(savedHair) do
        if acc then
            local handle = acc:FindFirstChild("Handle")
            local weld = handle and handle:FindFirstChild("AccessoryWeld")
            if weld then weld:Destroy() end -- clear any stale weld before re-adding
            if humanoid then humanoid:AddAccessory(acc) end
        end
    end
    savedHair = {}
end

