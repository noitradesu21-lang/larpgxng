-- ===== HEADLESS + KORBLOX PACKS (NEW) =====
local function applyHeadless(char)
    local head = char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end

    -- save originals (only once per body)
    if not packSaved.Headless then
        local removed = {}
        for _, v in ipairs(head:GetChildren()) do
            if v:IsA("Decal") or v:IsA("SpecialMesh") or v:IsA("CharacterMesh") then
                table.insert(removed, {Instance = v, Parent = head})
            end
        end
        packSaved.Headless = {
            Transparency = head.Transparency,
            Removed = removed,
        }
    end

    head.Transparency = 1
    head.CanCollide = false

    -- detach face / old meshes (kept in memory so reset can restore them)
    for _, entry in ipairs(packSaved.Headless.Removed) do
        if entry.Instance and entry.Instance.Parent then
            entry.Instance.Parent = nil
        end
    end

    -- headless mesh
    local mesh = head:FindFirstChild("HeadlessMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Name = "HeadlessMesh"
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = HEADLESS_MESH_ID
        mesh.Scale = Vector3.new(0.001, 0.001, 0.001)
        mesh.Parent = head
    end
end

local function resetHeadless(char)
    local head = char and char:FindFirstChild("Head")
    if not head then return end

    local mesh = head:FindFirstChild("HeadlessMesh")
    if mesh then mesh:Destroy() end

    if packSaved.Headless then
        head.Transparency = packSaved.Headless.Transparency
        for _, entry in ipairs(packSaved.Headless.Removed) do
            if entry.Instance then
                entry.Instance.Parent = head
            end
        end
        packSaved.Headless = nil
    end
end

local function applyKorblox(char)
    local rightLeg = char:FindFirstChild("Right Leg")
    if not rightLeg or not rightLeg:IsA("BasePart") then return end

    -- save originals (only once per body)
    if not packSaved.Korblox then
        local removed = {}
        for _, v in ipairs(rightLeg:GetChildren()) do
            if v:IsA("SpecialMesh") or v:IsA("CharacterMesh") then
                table.insert(removed, {Instance = v, Parent = rightLeg})
            end
        end
        packSaved.Korblox = { Removed = removed }
    end

    -- detach old meshes (kept for reset)
    for _, entry in ipairs(packSaved.Korblox.Removed) do
        if entry.Instance and entry.Instance.Parent then
            entry.Instance.Parent = nil
        end
    end

    -- Korblox mesh + texture
    local mesh = rightLeg:FindFirstChild("KorbloxMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Name = "KorbloxMesh"
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = KORBLOX_MESH_ID
        mesh.TextureId = KORBLOX_TEXTURE_ID
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = rightLeg
    end
end

local function resetKorblox(char)
    local rightLeg = char and char:FindFirstChild("Right Leg")
    if not rightLeg then return end

    local mesh = rightLeg:FindFirstChild("KorbloxMesh")
    if mesh then mesh:Destroy() end

    if packSaved.Korblox then
        for _, entry in ipairs(packSaved.Korblox.Removed) do
            if entry.Instance then
                entry.Instance.Parent = rightLeg
            end
        end
        packSaved.Korblox = nil
    end
end

local function updatePacks()
    if not Character then return end
    if packState.Headless then applyHeadless(Character) else resetHeadless(Character) end
    if packState.Korblox then applyKorblox(Character) else resetKorblox(Character) end
end

