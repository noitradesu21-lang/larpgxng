local function MakeTab(name, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1/4, -4, 1, 0)
    b.Position = UDim2.new((order - 1) / 4, 0, 0, 0)
    b.BackgroundColor3 = Theme.Btn
    b.BackgroundTransparency = Theme.TBtn
    b.Text = name
    b.TextColor3 = Theme.TxtD
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.Parent = TabHolder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = b

    local st = Instance.new("UIStroke")
    st.Thickness = 1
    st.Color = Theme.Sec
    st.Parent = b

    b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = Theme.Acc2}, 0.15) end)
    b.MouseLeave:Connect(function()
        if not tabs[name].selected then Tween(b, {BackgroundColor3 = Theme.Btn}, 0.15) end
    end)
    tabs[name] = {button = b, stroke = st}
    return b
end

