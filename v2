local function SelectTab(idx)
    PageEquip.Visible = idx == 1
    PageLegs.Visible = idx == 2
    PagePresets.Visible = idx == 3
    PageClone.Visible = idx == 4
    local order = {TabEquipBtn, TabLegsBtn, TabPresetsBtn, TabCloneBtn}
    for i, b in ipairs(order) do
        local t = tabs[b.Text]
        t.selected = (i == idx)
        b.TextColor3 = (i == idx) and Theme.Txt or Theme.TxtD
        b.BackgroundColor3 = (i == idx) and Theme.Acc2 or Theme.Btn
    end
    if idx == 3 then RefreshPresets() end
    if idx == 4 then RefreshPlayers() end
    if idx == 2 then
        -- Sync toggle visuals in case state changed elsewhere
        stylePackToggle(HeadlessBtn, "HEADLESS", "Headless")
        stylePackToggle(KorbloxBtn, "KORBLOX", "Korblox")
        styleBoth()
    end
end

