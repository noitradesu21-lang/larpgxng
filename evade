    -- Setup Filter Chips in Drawer
    local function setupFilterChips(itemType)
        for _, child in ipairs(FilterScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local categories = { "All" }
        if itemType == "Emote" then
            table.insert(categories, "Store")
            table.insert(categories, "Gamepasses")
            table.insert(categories, "Daily Shop")
            table.insert(categories, "Halloween")
            table.insert(categories, "Winter Holidays")
            table.insert(categories, "Summer")
            table.insert(categories, "Spring")
            table.insert(categories, "Special")
            table.insert(categories, "Other")
        else
            table.insert(categories, "Daily Shop")
            table.insert(categories, "Halloween")
            table.insert(categories, "Winter Holidays")
            table.insert(categories, "Gamepasses")
            table.insert(categories, "Summer")
            table.insert(categories, "Special")
            table.insert(categories, "Valentines")
            table.insert(categories, "Staff Exclusive")
            table.insert(categories, "Other")
        end

        for _, cat in ipairs(categories) do
            local Chip = Instance.new("TextButton")
            Chip.Size = UDim2.new(0, 0, 1, 0)
            Chip.AutomaticSize = Enum.AutomaticSize.X
            Chip.BackgroundColor3 = (State.ActiveCategoryFilter == cat) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(28, 28, 28)
            Chip.Text = "  " .. cat .. "  "
            Chip.TextColor3 = (State.ActiveCategoryFilter == cat) and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(160, 160, 160)
            Chip.Font = Helvetica
            Chip.TextSize = 10
            Chip.Parent = FilterScroll

            local CCorner = Instance.new("UICorner")
            CCorner.CornerRadius = UDim.new(0, 4)
            CCorner.Parent = Chip

            Chip.MouseButton1Click:Connect(function()
                State.ActiveCategoryFilter = cat
                setupFilterChips(itemType)
                populateDrawer(itemType, SearchBox.Text)
            end)
        end
    end

