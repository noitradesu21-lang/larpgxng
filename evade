-- Scan ReplicatedStorage for live ModuleScripts and link them
local function scanGameCosmetics()
    local function registerModule(mod, forcedType)
        if not mod or not mod:IsA("ModuleScript") then return end
        pcall(function()
            local success, data = pcall(require, mod)
            if not success or typeof(data) ~= "table" then return end

            local rawName = data.Name or mod.Name
            local displayName = (data.AppearanceInfo and data.AppearanceInfo.Name) or data.DisplayName or rawName
            local itemId = mod:GetAttribute("ID") or mod:GetAttribute("Id") or data.ID or data.Id or mod.Name

            local cRaw = cleanName(rawName)
            local cDisp = cleanName(displayName)
            local cMod = cleanName(mod.Name)

            -- Determine whether Emote or Unusual
            local isEmote = (forcedType == "Emote")
                or mod.Parent.Name == "Emotes"
                or mod.Name:lower():find("emote")
                or (data.Type == "Emote")
                or (data.Animation ~= nil or data.AnimationId ~= nil or data.Duration ~= nil)

            local isUnusual = (forcedType == "Unusual")
                or mod.Parent.Name:lower():find("unusual")
                or mod.Name:lower():find("unusual")
                or mod.Name:lower():find("cosmetic")
                or (data.Type == "Unusual" or data.Type == "Cosmetic")
                or (mod:FindFirstChildOfClass("ParticleEmitter") ~= nil or mod:FindFirstChildOfClass("Attachment") ~= nil)

            if not isEmote and not isUnusual then
                if State.Emotes.ByClean[cRaw] or State.Emotes.ByClean[cDisp] or State.Emotes.ByClean[cMod] then
                    isEmote = true
                elseif State.Unusuals.ByClean[cRaw] or State.Unusuals.ByClean[cDisp] or State.Unusuals.ByClean[cMod] then
                    isUnusual = true
                end
            end

            if isEmote then
                local existing = State.Emotes.ByClean[cDisp] or State.Emotes.ByClean[cRaw] or State.Emotes.ByClean[cMod]
                if existing then
                    existing.Module = mod
                    existing.Data = data
                    existing.InGame = true
                    existing.Id = itemId
                    if itemId then State.Emotes.ById[tostring(itemId)] = existing end
                else
                    local newEntry = {
                        Module = mod,
                        Name = rawName,
                        DisplayName = tostring(displayName),
                        Category = "In-Game Live",
                        Id = itemId,
                        Data = data,
                        CleanName = cRaw,
                        CleanDisplay = cDisp,
                        InGame = true,
                        Type = "Emote"
                    }
                    State.Emotes.ByClean[cRaw] = newEntry
                    State.Emotes.ByClean[cDisp] = newEntry
                    if itemId then State.Emotes.ById[tostring(itemId)] = newEntry end
                    table.insert(State.Emotes.List, newEntry)
                end
            elseif isUnusual then
                local existing = State.Unusuals.ByClean[cDisp] or State.Unusuals.ByClean[cRaw] or State.Unusuals.ByClean[cMod]
                if existing then
                    existing.Module = mod
                    existing.Data = data
                    existing.InGame = true
                    existing.Id = itemId
                    if itemId then State.Unusuals.ById[tostring(itemId)] = existing end
                else
                    local newEntry = {
                        Module = mod,
                        Name = rawName,
                        DisplayName = tostring(displayName),
                        Category = "In-Game Live",
                        Id = itemId,
                        Data = data,
                        CleanName = cRaw,
                        CleanDisplay = cDisp,
                        InGame = true,
                        Type = "Unusual"
                    }
                    State.Unusuals.ByClean[cRaw] = newEntry
                    State.Unusuals.ByClean[cDisp] = newEntry
                    if itemId then State.Unusuals.ById[tostring(itemId)] = newEntry end
                    table.insert(State.Unusuals.List, newEntry)
                end
            end
        end)
    end

    -- 1. Scan Items Folder
    local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
    if itemsFolder then
        for _, desc in ipairs(itemsFolder:GetDescendants()) do
            if desc:IsA("ModuleScript") then
                registerModule(desc)
            end
        end
    end

    -- 2. Scan Registry if present
    local registry = ReplicatedStorage:FindFirstChild("Registry")
    if registry and registry:IsA("ModuleScript") then
        pcall(function()
            local reg = require(registry)
            if type(reg.GetAll) == "function" then
                for _, item in ipairs(reg:GetAll()) do
                    if item.Module then
                        if item.Type == "Emote" then
                            registerModule(item.Module, "Emote")
                        elseif item.Type == "Unusual" or item.Type == "Cosmetic" then
                            registerModule(item.Module, "Unusual")
                        else
                            registerModule(item.Module)
                        end
                    end
                end
            end
        end)
    end

    -- 3. Fallback scan all descendants in ReplicatedStorage
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("ModuleScript") then
            local pName = desc.Parent.Name:lower()
            local mName = desc.Name:lower()
            if pName:find("emote") or mName:find("emote") or pName:find("unusual") or mName:find("unusual") or pName:find("cosmetic") or mName:find("cosmetic") then
                registerModule(desc)
            end
        end
    end

    table.sort(State.Emotes.List, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)
    table.sort(State.Unusuals.List, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)
end

scanGameCosmetics()

--------------------------------------------------------------------------------
-- RESOLUTION HELPERS (Fuzzy & Alias Lookup)
--------------------------------------------------------------------------------
local function resolveItem(itemType, query)
    if not query or query:gsub("%s+", "") == "" then return nil end
    local scope = (itemType == "Emote") and State.Emotes or State.Unusuals
    local aliases = (itemType == "Emote") and ALIASES.Emotes or ALIASES.Unusuals
    local cleanQ = cleanName(query)

    -- Check alias mapping
    if aliases[cleanQ] then
        local targetName = aliases[cleanQ]
        local found = scope.ByClean[cleanName(targetName)]
        if found then return found end
    end

    -- Direct clean match
    if scope.ByClean[cleanQ] then
        return scope.ByClean[cleanQ]
    end

    -- Direct ID match
    if scope.ById[query] then
        return scope.ById[query]
    end

    -- Prefix match
    for _, item in ipairs(scope.List) do
        if item.CleanDisplay:find("^" .. cleanQ) or item.CleanName:find("^" .. cleanQ) then
            return item
        end
    end

    -- Substring match
    for _, item in ipairs(scope.List) do
        if item.CleanDisplay:find(cleanQ, 1, true) or item.CleanName:find(cleanQ, 1, true) then
            return item
        end
    end

    return nil
end

--------------------------------------------------------------------------------
-- PHYSICAL SWAPPING ENGINE (Emotes & Unusuals)
--------------------------------------------------------------------------------
local function physicalSwapEmote(origEmote, repEmote)
    if not origEmote or not repEmote then return false, "Invalid emote arguments." end

    local origMod = origEmote.Module
    local repMod = repEmote.Module

    if not origMod then
        return false, string.format("Original emote '%s' is not loaded in game memory.", origEmote.DisplayName)
    end
    if not repMod then
        return false, string.format("Replacement emote '%s' is not loaded in game memory.", repEmote.DisplayName)
    end

    -- 1. Backup original data & sounds
    if not State.Emotes.Backups[origEmote.CleanName] then
        local origData = pcall(require, origMod) and require(origMod) or {}
        local backupFolder = Instance.new("Folder")
        backupFolder.Name = "__OriginalBackup"

        local dataVal = Instance.new("StringValue")
        dataVal.Name = "OriginalDataJSON"
        pcall(function() dataVal.Value = HttpService:JSONEncode(origData) end)
        dataVal.Parent = backupFolder

        local soundVal = Instance.new("StringValue")
        soundVal.Name = "OriginalSoundsJSON"
        local sounds = {}
        for _, sound in ipairs(origMod:GetDescendants()) do
            if sound:IsA("Sound") then
                table.insert(sounds, { Name = sound.Name, SoundId = sound.SoundId })
            end
        end
        pcall(function() soundVal.Value = HttpService:JSONEncode(sounds) end)
        soundVal.Parent = backupFolder

        backupFolder.Parent = origMod
        State.Emotes.Backups[origEmote.CleanName] = {
            SavedData = origData,
            Folder = backupFolder
        }
    end

    -- 2. Physical Module & Asset Swap
    local swapOk, err = pcall(function()
        local repData = require(repMod)
        local origData = require(origMod)
        if typeof(origData) == "table" and typeof(repData) == "table" then
            table.clear(origData)
            for k, v in pairs(repData) do
                if typeof(v) == "table" then
                    local tblClone = {}
                    for tk, tv in pairs(v) do
                        tblClone[tk] = tv
                    end
                    origData[k] = tblClone
                else
                    origData[k] = v
                end
            end

            -- Display the name of the SWAPPED (target/replacement) emote
            if origData.AppearanceInfo then
                origData.AppearanceInfo.Name = repEmote.DisplayName
            else
                origData.AppearanceInfo = { Name = repEmote.DisplayName }
            end
            origData.DisplayName = repEmote.DisplayName
            origData.Name = repEmote.Name or repEmote.DisplayName
        end

        for _, child in ipairs(origMod:GetChildren()) do
            if child.Name ~= "__OriginalBackup" then
                child:Destroy()
            end
        end
        for _, child in ipairs(repMod:GetChildren()) do
            if child.Name ~= "__OriginalBackup" then
                local clone = child:Clone()
                clone.Parent = origMod
            end
        end

        -- Update any existing in-game UI labels in PlayerGui to show the swapped name
        updateInGameUILabels(origEmote.DisplayName, repEmote.DisplayName)
    end)

    if not swapOk then
        return false, "Swap error: " .. tostring(err)
    end

    State.Emotes.Map[origEmote.CleanName] = {
        Orig = origEmote,
        Rep = repEmote
    }

    print(string.format("[Cosmetic Changer] Swapped Emote: %s -> %s", origEmote.DisplayName, repEmote.DisplayName))
    return true
end

