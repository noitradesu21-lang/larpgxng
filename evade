    -- Emote Swap Action
    EmoteSwapBtn.MouseButton1Click:Connect(function()
        local origText = EmoteOrigBox.Text:gsub("^%s*(.-)%s*$", "%1")
        local repText = EmoteRepBox.Text:gsub("^%s*(.-)%s*$", "%1")

        if origText == "" or repText == "" then
            EmoteStatus.Text = "Error: Please enter both Original and Target emotes!"
            EmoteStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
            return
        end

        local origItem = resolveItem("Emote", origText)
        local repItem = resolveItem("Emote", repText)

        if not origItem then
            EmoteStatus.Text = string.format("Error: Original emote '%s' not recognized!", origText)
            EmoteStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
            return
        end
        if not repItem then
            EmoteStatus.Text = string.format("Error: Replacement emote '%s' not recognized!", repText)
            EmoteStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
            return
        end

        local ok, err = physicalSwapEmote(origItem, repItem)
        if ok then
            refreshAllSwapsUI()
            EmoteStatus.Text = string.format("Swap Success: %s ➔ %s", origItem.DisplayName, repItem.DisplayName)
            EmoteStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            EmoteStatus.Text = "Swap Failed: " .. tostring(err)
            EmoteStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)

