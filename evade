local function initDatabases()
    -- 1. Initialize Emotes from Wiki catalog
    table.clear(State.Emotes.ByClean)
    table.clear(State.Emotes.ById)
    table.clear(State.Emotes.List)

    for _, w in ipairs(WIKI_EMOTES) do
        local entry = {
            Name = w.Name,
            DisplayName = w.Name,
            Category = w.Category or "Store",
            Moveable = w.Moveable,
            Price = w.Price or "",
            CleanName = cleanName(w.Name),
            CleanDisplay = cleanName(w.Name),
            Module = nil,
            InGame = false,
            Type = "Emote"
        }
        State.Emotes.ByClean[entry.CleanName] = entry
        table.insert(State.Emotes.List, entry)
    end

    -- 2. Initialize Unusuals from Wiki catalog
    table.clear(State.Unusuals.ByClean)
