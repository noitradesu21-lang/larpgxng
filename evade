--------------------------------------------------------------------------------
-- RESTORE LOGIC
--------------------------------------------------------------------------------
local function restoreEmote(origName)
    local clean = cleanName(origName)
    local swapData = State.Emotes.Map[clean]
    if not swapData then return false end

    local origEmote = swapData.Orig
    local repEmote = swapData.Rep
    local origMod = origEmote.Module
    local backup = State.Emotes.Backups[clean]

    if origMod and backup and backup.SavedData then
        pcall(function()
            local origData = require(origMod)
            table.clear(origData)
            for k, v in pairs(backup.SavedData) do
                origData[k] = v
            end

            for _, child in ipairs(origMod:GetChildren()) do
                if child.Name ~= "__OriginalBackup" then
                    child:Destroy()
                end
            end
            if backup.Folder then
                backup.Folder:Destroy()
            end

            -- Revert UI labels back to original name
            updateInGameUILabels(repEmote.DisplayName, origEmote.DisplayName)
        end)
    end

    State.Emotes.Map[clean] = nil
    State.Emotes.Backups[clean] = nil
    print(string.format("[Cosmetic Changer] Emote restored: %s", origEmote.DisplayName))
    return true
end

local function restoreUnusual(origName)
    local clean = cleanName(origName)
    local swapData = State.Unusuals.Map[clean]
    if not swapData then return false end

    local origUnusual = swapData.Orig
    local repUnusual = swapData.Rep
    local origMod = origUnusual.Module
    local backup = State.Unusuals.Backups[clean]

    if origMod and backup and backup.SavedData then
        pcall(function()
            local origData = require(origMod)
            table.clear(origData)
            for k, v in pairs(backup.SavedData) do
                origData[k] = v
            end

            for _, child in ipairs(origMod:GetChildren()) do
                if child.Name ~= "__OriginalBackup" then
                    child:Destroy()
                end
            end
            if backup.Folder then
                backup.Folder:Destroy()
            end

            -- Revert UI labels back to original name
            updateInGameUILabels(repUnusual.DisplayName, origUnusual.DisplayName)
        end)
    end

    State.Unusuals.Map[clean] = nil
    State.Unusuals.Backups[clean] = nil
    refreshRig()
    print(string.format("[Cosmetic Changer] Unusual restored: %s", origUnusual.DisplayName))
    return true
end

local function restoreAllEmotes()
    for clean, _ in pairs(State.Emotes.Map) do
        restoreEmote(clean)
    end
    table.clear(State.Emotes.Map)
    table.clear(State.Emotes.Backups)
end

local function restoreAllUnusuals()
    for clean, _ in pairs(State.Unusuals.Map) do
        restoreUnusual(clean)
    end
    table.clear(State.Unusuals.Map)
    table.clear(State.Unusuals.Backups)
    refreshRig()
end

local function restoreEverything()
    restoreAllEmotes()
    restoreAllUnusuals()
    print("[Cosmetic Changer] All Emotes & Unusuals have been restored to default.")
end

