--------------------------------------------------------------------------------
-- LIVE IN-GAME UI LABEL SYNCHRONIZER
--------------------------------------------------------------------------------
local function updateInGameUILabels(oldName, newName)
    if not oldName or not newName or oldName == newName then return end
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return end

        local cleanOld = cleanName(oldName)

        for _, desc in ipairs(playerGui:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                if desc.Text == oldName or cleanName(desc.Text) == cleanOld then
                    desc.Text = newName
                end
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- RIG / COSMETIC REFRESH LOGIC (For Unusuals)
--------------------------------------------------------------------------------
local function refreshRig()
    pcall(function()
        -- 1. Try Evade RigService if present
        local services = ReplicatedStorage:FindFirstChild("Services")
        if services then
            local asset = services:FindFirstChild("Asset")
            if asset then
                local rigServiceMod = asset:FindFirstChild("RigService")
                if rigServiceMod and rigServiceMod:IsA("ModuleScript") then
                    local rigService = require(rigServiceMod)
                    if type(rigService.AddCosmetics) == "function" then
                        local char = LocalPlayer.Character
                        if char then
                            rigService.AddCosmetics(char)
                        end
                    end
                end
            end
        end

        -- 2. Fallback: refresh attachments & particles on Character & Workspace.Rigs
        local targets = {}
        if LocalPlayer.Character then table.insert(targets, LocalPlayer.Character) end
        local rigs = Workspace:FindFirstChild("Rigs")
        if rigs then
            for _, r in ipairs(rigs:GetChildren()) do
                if r.Name == LocalPlayer.Name or r:FindFirstChildOfClass("Humanoid") then
                    table.insert(targets, r)
                end
            end
        end

        for _, model in ipairs(targets) do
            for _, desc in ipairs(model:GetDescendants()) do
                if desc:IsA("ParticleEmitter") then
                    desc.Enabled = false
                    task.delay(0.05, function()
                        if desc and desc.Parent then desc.Enabled = true end
                    end)
                end
            end
        end
    end)
end

