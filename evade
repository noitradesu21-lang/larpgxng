    ----------------------------------------------------------------------------
    local function switchTab(tabName)
        State.ActiveTab = tabName

        EmotesView.Visible = (tabName == "Emotes")
        UnusualsView.Visible = (tabName == "Unusuals")
        SwapsView.Visible = (tabName == "Swaps")

        EmotesTabBtn.BackgroundColor3 = (tabName == "Emotes") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(26, 26, 26)
        EmotesTabBtn.TextColor3 = (tabName == "Emotes") and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(160, 160, 160)

        UnusualsTabBtn.BackgroundColor3 = (tabName == "Unusuals") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(26, 26, 26)
