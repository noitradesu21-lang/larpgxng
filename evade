    ----------------------------------------------------------------------------
    -- POPULATE DRAWER LOGIC
    ----------------------------------------------------------------------------
    local function populateDrawer(itemType, query)
        for _, child in ipairs(DrawerScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local isEmote = (itemType == "Emote")
        DrawerTitle.Text = isEmote and string.format("Evade Emotes Catalog (%d)", #State.Emotes.List)
                                   or string.format("Evade Unusuals Catalog (%d)", #State.Unusuals.List)

        local targetList = isEmote and State.Emotes.List or State.Unusuals.List
        local qClean = cleanName(query or "")
        local catFilter = State.ActiveCategoryFilter

        for _, item in ipairs(targetList) do
            local catClean = cleanName(item.Category or "")
            local passCat = (catFilter == "All") or (item.Category == catFilter)
            local passSearch = (qClean == "")
                or item.CleanDisplay:find(qClean, 1, true)
                or item.CleanName:find(qClean, 1, true)
                or catClean:find(qClean, 1, true)

            if passCat and passSearch then
                local Row = Instance.new("Frame")
                Row.Size = UDim2.new(1, -6, 0, 28)
                Row.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                Row.Parent = DrawerScroll

                local RCorner = Instance.new("UICorner")
                RCorner.CornerRadius = UDim.new(0, 4)
                RCorner.Parent = Row

                -- In-Game Status Dot
                local StatusDot = Instance.new("Frame")
